---
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  title: string;
}

const { images, title } = Astro.props;
const showcaseImages = images.slice(0, 3);
---

<figure class="motion-showcase" aria-label={`Motion study concept for ${title}`}>
  <div class="motion-showcase__visual">
    {showcaseImages.map((image, index) => (
      <img
        class:list={['motion-showcase__image', index === 0 && 'motion-showcase__image--first']}
        src={image.src}
        alt=""
        loading={index === 0 ? 'eager' : 'lazy'}
        decoding="async"
      />
    ))}
    <div class="motion-showcase__shade"></div>
    <figcaption class="motion-showcase__caption">
      <span class="eyebrow">MOTION STUDY · VISUAL CONCEPT</span>
      <span class="motion-showcase__title">{title}</span>
    </figcaption>
  </div>
</figure>
