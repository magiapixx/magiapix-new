---
import '../styles.css';
import { ClientRouter } from 'astro:transitions';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}

const {
  title = 'Magiapix | Creative Web Development & Brand Visualization Agency',
  description = 'Magiapix is a creative web development studio crafting distinctive digital experiences for ambitious brands.',
  type = 'website',
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Magiapix" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;1,400;1,500&family=Geist:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SiteHeader pathname={Astro.url.pathname} />
    <slot />
    <SiteFooter />
    <script>
      const revealSelectors = [
        '.intro-section > .shell > *',
        '.proof-copy > *',
        '.proof-visuals img',
        '.section-heading > *',
        '.work-item',
        '.concept-note',
        '.motion-showcase',
        '.service-lines > *',
        '.journal-item',
        '.page-intro > *',
        '.service-row',
        '.process-step',
        '.about-wide-image',
        '.about-statement > *',
        '.about-principles-grid > *',
        '.detail-intro > *',
        '.detail-content > *',
        '.detail-gallery figure',
        '.detail-language > *',
        '.detail-keyword',
        '.detail-process-step',
        '.detail-result > *',
        '.detail-next > *',
        '.article-body > *',
        '.article-end > *',
        '.closing-inner > *',
      ].join(',');

      const revealPageContent = () => {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion || !('IntersectionObserver' in window)) return;

        const elements = document.querySelectorAll<HTMLElement>(revealSelectors);
        if (elements.length === 0) return;

        const observer = new IntersectionObserver(
          (entries, currentObserver) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              currentObserver.unobserve(entry.target);
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        );

        elements.forEach((element, index) => {
          element.classList.add('reveal-item');
          const serviceIndex = element.parentElement?.matches('.service-lines')
            ? Array.from(element.parentElement.children).indexOf(element)
            : -1;
          const delay = serviceIndex >= 0 ? serviceIndex * 140 : (index % 4) * 70;
          element.style.setProperty('--reveal-delay', `${delay}ms`);
          observer.observe(element);
        });

        document.documentElement.classList.add('motion-ready');
      };

      revealPageContent();
      document.addEventListener('astro:page-load', revealPageContent);
    </script>
  </body>
</html>
