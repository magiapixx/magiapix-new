---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClosingCTA from '../../components/site/ClosingCTA.astro';
import WorkGrid from '../../components/site/WorkGrid.astro';
---

<BaseLayout
  title="Our Works | Magiapix"
  description="Explore visual concept studies in brand visualization, digital experience, and creative web development by Magiapix."
>
  <main>
    <section class="page-intro shell">
      <span class="eyebrow">/ SELECTED WORK</span>
      <h1>Work with <em>a point of view.</em></h1>
      <p>A collection of visual directions for brands that want their digital presence to say something meaningful.</p>
    </section>
    <section class="shell works-page-grid">
      <WorkGrid />
      <p class="concept-note">These are visual concept studies created for this website. They are not presented as commissioned client work.</p>
    </section>
    <ClosingCTA />
  </main>
</BaseLayout>
