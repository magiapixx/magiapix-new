---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClosingCTA from '../components/site/ClosingCTA.astro';
import Icon from '../components/site/Icon.astro';
import JournalGrid from '../components/site/JournalGrid.astro';
import SectionHeading from '../components/site/SectionHeading.astro';
import WorkGrid from '../components/site/WorkGrid.astro';
import analyticsImage from '../assets/unsplash-analytics.webp';
import mobileAppImage from '../assets/unsplash-mobile-app.webp';
---

<script>
  import { mountHeroWaveGrid } from '../scripts/hero-wave-grid';

  let activeCanvas: HTMLCanvasElement | undefined;
  let cleanup: (() => void) | undefined;

  const mount = () => {
    const canvas = document.querySelector<HTMLCanvasElement>('.hero-wave-grid');
    if (!canvas || canvas === activeCanvas) return;
    cleanup?.();
    activeCanvas = canvas;
    cleanup = mountHeroWaveGrid(canvas);
  };

  const unmount = () => {
    cleanup?.();
    cleanup = undefined;
    activeCanvas = undefined;
  };

  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', unmount);
  if (document.readyState !== 'loading') mount();
</script>

<BaseLayout>
  <main>
    <section class="home-hero">
      <canvas class="hero-wave-grid" aria-hidden="true"></canvas>
      <div class="hero-shade"></div>
      <div class="shell hero-content">
        <div class="hero-bottom">
          <div>
            <h1><span class="hero-muted">Where ambitious brands</span><br /><em><span class="hero-muted">become</span> <span class="hero-emphasis-word">unforgettable</span></em></h1>
          </div>
        </div>
      </div>
      <a class="hero-scroll" href="#introduction" aria-label="Scroll to introduction"><Icon name="arrow-down" size={17} /></a>
    </section>
    <section class="intro-section section-pad" id="introduction">
      <div class="shell">
        <span class="eyebrow">/ ABOUT MAGIAPIX</span>
        <div class="intro-copy">
          <p>
            Your brand is more than a logo. It’s your story, your values, and the promise you make to the people who trust you.
            We help you share that story online, in a way that feels as polished and genuine as the business you’ve built.
          </p>
          <p><strong>When someone visits for the first time, they should feel it right away: you’re clear, you’re consistent, and you care.</strong></p>
          <a href="/about" class="text-link">Meet the studio <Icon name="arrow-right" size={17} /></a>
        </div>
      </div>
    </section>
    <section class="proof-section">
      <div class="shell proof-grid">
        <div class="proof-copy">
          <span class="eyebrow">/ WHAT WE BELIEVE</span>
          <h2>Premium is in <em>the details.</em></h2>
          <p>We focus on creative web development and brand visualization, shaping digital spaces where every detail reflects the quality of the business behind it.</p>
          <div class="proof-list">
            <div><span>01</span><p>Specialized, not scattered.</p></div>
            <div><span>02</span><p>Design meets performance.</p></div>
            <div><span>03</span><p>Built for ambition.</p></div>
          </div>
          <a href="/services" class="text-link">How we work <Icon name="arrow-right" size={17} /></a>
        </div>
        <div class="proof-visuals">
          <div class="proof-visual"><img src={analyticsImage.src} alt="Laptop displaying web performance analytics charts and metrics" loading="lazy" /></div>
          <div class="proof-visual"><img src={mobileAppImage.src} alt="Smartphone displaying app icons beside a laptop keyboard" loading="lazy" /></div>
        </div>
      </div>
    </section>
    <section class="section-pad">
      <div class="shell">
        <SectionHeading label="SELECTED WORK" title="Made to be felt." link="/our-works" linkText="All projects" />
        <WorkGrid limit={3} />
        <p class="concept-note">Selected visual concept studies created for this site; not commissioned client projects.</p>
      </div>
    </section>
    <section class="services-preview section-pad">
      <div class="shell">
        <SectionHeading label="OUR CAPABILITIES" title="What we do best." link="/services" linkText="Explore services" />
        <div class="service-lines">
          <a href="/services"><span>Creative Web Development</span><Icon name="arrow-right" /></a>
          <a href="/services"><span>Brand Visualization</span><Icon name="arrow-right" /></a>
          <a href="/services"><span>Business Website Design</span><Icon name="arrow-right" /></a>
          <a href="/services"><span>Digital Experience &amp; Motion</span><Icon name="arrow-right" /></a>
        </div>
      </div>
    </section>
    <section class="section-pad">
      <div class="shell">
        <SectionHeading label="THE JOURNAL" title="Notes from the studio." link="/blog" linkText="All stories" />
        <JournalGrid limit={2} />
      </div>
    </section>
    <ClosingCTA />
  </main>
</BaseLayout>
